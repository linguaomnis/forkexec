#!/bin/bash

PROGNAME=$(basename $0);
RET_OK=0;
RET_NG=1;
CONF="${FORKEXEC}/etc/hkrup.conf";
EXT_PTN="(jpg|JPG|jpeg|JPEG|png|PNG|bmp|BMP|gif|GIF)";
URL_ROOT=$(     awk '$1 == "url_root"   {print $2}' ${CONF} );
DIR_ROOT=$(     awk '$1 == "dir_root"   {print $2}' ${CONF} );
DIR_ORG=$(      awk '$1 == "dir_org"    {print $2}' ${CONF} );
DIR_CACHE=$(    awk '$1 == "dir_cache"  {print $2}' ${CONF} );
LOG_WATCH=$(    awk '$1 == "log_watch"  {print $2}' ${CONF} );
LOG=$(          awk '$1 == "log"        {print $2}' ${CONF} );
LOG_REP=$(      awk '$1 == "log_rep"    {print $2}' ${CONF} );
USER=$(         awk '$1 == "user"       {print $2}' ${CONF} );
PASS=$(         awk '$1 == "pass"       {print $2}' ${CONF} );
UPDATE_PARA=$(  awk '$1 == "update_para"{print $2}' ${CONF} );
NULL="__NULL__";

WTD=$( hkrupwtd | sed -E "/^\s*(#|$)/d" );

# delete <path>
# cache <type> <path_org> <path_cache>

function _awkscript ()
{
cat <<DOC
{
    _type  = \$1;
}
_type == "delete" {
    _path1 = \$2;
    printf( "rm %s;\n", _path1 );
}
_type == "cache" {
    _cache = \$2;
    _path1 = \$3;
    _path2 = \$4;
    switch( _cache ) {
    case "h100":
        _resize = "x100";
        break;
    case "h200":
        _resize = "x200";
        break;
    case "h500":
        _resize = "x500";
        break;
    case "w100":
        _resize = "100x";
        break;
    case "w200":
        _resize = "200x";
        break;
    case "w500":
        _resize = "500x";
        break;
    default:
        _resize = "undefined";
        break;
    }
    printf( "convert %s \$(izmDelExifOpt %s) -resize %s %s\n", _path1, _path1, _resize, _path2 );
}
DOC
}

CMD=$(
    echo "${WTD}" \
    | awk -f <( _awkscript ) \
    ;
);

if [[ -z "${CMD}" ]]; then
    >&2 echo "nothing to do.";
    exit ${RET_OK};
fi

echo "${CMD}";
>&2 printf "ok? [y|n] ";
read INPUT;

case "${INPUT}" in
y)
    >&2 echo "BEGIN";
    echo "${CMD}" | xargs -P ${UPDATE_PARA} -I CMD bash -c "CMD"; 
    >&2 echo "END";
    exit ${RET_OK};
    ;;
*)
    >&2 echo "not proceeded.";
    exit ${RET_NG};
    ;;
esac

