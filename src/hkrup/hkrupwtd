#!/bin/bash

PROGNAME=$(basename $0);
CONF="${FORKEXEC}/etc/hkrup.conf";
EXT_PTN="(jpg|JPG|jpeg|JPEG|png|PNG|bmp|BMP|gif|GIF)";
URL_ROOT=$(     awk '$1 == "url_root"   {print $2}' ${CONF} );
DIR_ROOT=$(     awk '$1 == "dir_root"   {print $2}' ${CONF} );
DIR_ORG=$(      awk '$1 == "dir_org"    {print $2}' ${CONF} );
DIR_CACHE=$(    awk '$1 == "dir_cache"  {print $2}' ${CONF} );
LOG_WATCH=$(    awk '$1 == "log_watch"  {print $2}' ${CONF} );
LOG=$(          awk '$1 == "log"        {print $2}' ${CONF} );
LOG_REP=$(      awk '$1 == "log_rep"    {print $2}' ${CONF} );
USER=$(         awk '$1 == "user"       {print $2}' ${CONF} );
PASS=$(         awk '$1 == "pass"       {print $2}' ${CONF} );
NULL="__NULL__";

INFO=$( hkrupinfo | sed -E "/^\s*(#|$)/d" );

# id ext fname path_org path_h100 path_h200 path_h500 path_w100 path_w200 path_w500

echo "${INFO}" \
| awk -v _null="${NULL}" -v _dir_cache="${DIR_CACHE}" '
    {
        _id         = $1;
        _ext        = $2;
        _fname      = $3;
        _path_org   = $4;
        _path_h100  = $5;
        _path_h200  = $6;
        _path_h500  = $7;
        _path_w100  = $8;
        _path_w200  = $9;
        _path_w500  = $10;

        if( _path_org == _null ) {
            if( _path_h100 != _null ) { printf( "%s %s\n", "delete", _path_h100 ); }
            if( _path_h200 != _null ) { printf( "%s %s\n", "delete", _path_h200 ); }
            if( _path_h500 != _null ) { printf( "%s %s\n", "delete", _path_h500 ); }
            if( _path_w100 != _null ) { printf( "%s %s\n", "delete", _path_w100 ); }
            if( _path_w200 != _null ) { printf( "%s %s\n", "delete", _path_w200 ); }
            if( _path_w500 != _null ) { printf( "%s %s\n", "delete", _path_w500 ); }
        }else{
            _path_h100_if = _dir_cache "/h100/" _fname;
            _path_h200_if = _dir_cache "/h200/" _fname;
            _path_h500_if = _dir_cache "/h500/" _fname;
            _path_w100_if = _dir_cache "/w100/" _fname;
            _path_w200_if = _dir_cache "/w200/" _fname;
            _path_w500_if = _dir_cache "/w500/" _fname;
            if( _path_h100 == _null ) { printf( "%s %s %s %s\n", "cache", "h100", _path_org, _path_h100_if ); }
            if( _path_h200 == _null ) { printf( "%s %s %s %s\n", "cache", "h200", _path_org, _path_h200_if ); }
            if( _path_h500 == _null ) { printf( "%s %s %s %s\n", "cache", "h500", _path_org, _path_h500_if ); }
            if( _path_w100 == _null ) { printf( "%s %s %s %s\n", "cache", "w100", _path_org, _path_w100_if ); }
            if( _path_w200 == _null ) { printf( "%s %s %s %s\n", "cache", "w200", _path_org, _path_w200_if ); }
            if( _path_w500 == _null ) { printf( "%s %s %s %s\n", "cache", "w500", _path_org, _path_w500_if ); }
        }
    }
' \
; 

